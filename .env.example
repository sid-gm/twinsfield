# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# "standard" ($0.126/s) or "pro" ($0.168/s) for Kling 3.0 motion control
KLING_TIER=standard

# Wan 2.2 Animate Replace resolution: 480p ($0.04/s), 580p ($0.06/s), 720p ($0.08/s)
WAN_RESOLUTION=480p

# Set to 1 to test the whole flow without calling fal (returns the template clip as the "result")
MOCK_FAL=0

PORT=3000
