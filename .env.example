# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Seedance 2.5 output resolution: 480p (~$0.13/s billed on input+output seconds) or 720p (~$0.28/s)
SEEDANCE_RESOLUTION=480p

# Vision model used to analyze templates and photos (fal OpenRouter endpoint)
QA_MODEL=google/gemini-2.5-flash

# Set to 1 to test the whole flow without calling fal (returns the template clip as the "result")
MOCK_FAL=0

PORT=3000
